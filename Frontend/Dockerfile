# ============================================================
# Stage 1 - deps: Install dependencies only
# ============================================================
FROM node:20-alpine AS deps

# Install libc compat for native modules (e.g. sharp)
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package manifests and install production + dev deps
COPY package.json package-lock.json* ./
RUN npm ci

# ============================================================
# Stage 2 - builder: Build the Next.js application
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Receive build-time environment variables
ARG NEXT_PUBLIC_API_URL=https://api.flownix.my.id/api
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

# Expose them so Next.js can embed them at build time
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY

# Disable Next.js telemetry during the build
ENV NEXT_TELEMETRY_DISABLED=1

# Copy installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the rest of the source code
COPY . .

# Build the application (next build)
RUN npm run build

# ============================================================
# Stage 3 - runner: Minimal production image
# ============================================================
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Copy the standalone server bundle
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Copy static assets
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy the public directory (fonts, images, etc.)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]
