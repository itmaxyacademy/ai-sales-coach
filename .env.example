# =====================================================
# .env - ROOT (Development/Local Config)
# =====================================================
# File ini di-track di Git (Private Repo) untuk zero-config.
# Kredensial database Supabase dan API Key harus diisi masing-masing developer.
# =====================================================

# ─────────────────────────────────────────────────
# DATABASE - SUPABASE POSTGRESQL (Shared DB)
# ─────────────────────────────────────────────────
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/postgres"

# ─────────────────────────────────────────────────
# SUPABASE - BACKEND
# ─────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-key-here"

# ─────────────────────────────────────────────────
# SUPABASE - FRONTEND (Anon Key)
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ─────────────────────────────────────────────────
# AI / LLM (OpenAI)
# ─────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"

# ─────────────────────────────────────────────────
# AUTH - JWT
# ─────────────────────────────────────────────────
JWT_SECRET="replace-with-long-random-secret"
JWT_EXPIRES_IN="1d"

# ─────────────────────────────────────────────────
# APP ENVIRONMENT
# ─────────────────────────────────────────────────
NODE_ENV="development"

# ─────────────────────────────────────────────────
# BACKEND SERVER
# ─────────────────────────────────────────────────
PORT=5000
HOST="0.0.0.0"

# ─────────────────────────────────────────────────
# CORS & ENDPOINTS - LOCAL DEVELOPMENT
# ─────────────────────────────────────────────────
# Port 3002 adalah port host untuk Frontend di docker-compose.yml lokal
FRONTEND_ORIGIN="http://localhost:3002"
FRONTEND_ORIGINS="http://localhost:3002,http://localhost:3000"

# Port 5100 adalah port host untuk Backend di docker-compose.yml lokal
NEXT_PUBLIC_API_URL="http://localhost:5100/api"
NEXT_PUBLIC_APP_NAME="Sales AI Coach"

# Voice features (default ON). Set to "false" to disable.
NEXT_PUBLIC_FEATURE_FULL_DUPLEX="true"
NEXT_PUBLIC_FEATURE_LIVE_FILLER="true"
NEXT_PUBLIC_FEATURE_HANDS_FREE="true"

# ─────────────────────────────────────────────────
# LAYANAN PYTHON - Docker Internal DNS
# ─────────────────────────────────────────────────
TTS_PYTHON_URL=http://tts:5001
SCRAPER_PYTHON_URL=http://scraper:8001
