# Dependencies (installed fresh inside the image)
node_modules

# TypeScript build output (rebuilt inside the image)
dist

# Environment secrets – NEVER bake into image
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js (not part of the backend, just in case)
.next

# OS / editor artefacts
.DS_Store
Thumbs.db
.vscode
.idea

# Docker files themselves (avoid recursive copy confusion)
Dockerfile
.dockerignore
